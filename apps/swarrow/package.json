{
  "name": "swarrow.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "bun test tests/seo/content.test.ts",
    "test:seo": "PUBLIC_GA_MEASUREMENT_ID=G-TEST0000000 bun test tests/seo/content.test.ts && PUBLIC_GA_MEASUREMENT_ID=G-TEST0000000 bun --bun run build && bun test tests/seo/build-output.test.ts",
    "check": "biome check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:fix": "biome check --write",
    "clean": "git clean -xdf node_modules build .svelte-kit",
    "update": "bun update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/bun": "1.3.14",
    "lefthook": "2.1.9",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  },
  "dependencies": {
    "@lucide/svelte": "1.59.0",
    "@vecta/site-content": "workspace:*"
  }
}
